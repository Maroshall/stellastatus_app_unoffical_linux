{
  "name": "stellastatus-app",
  "productName": "StellaStatus",
  "desktopName": "StellaStatus",
  "version": "1.0.6",
  "fullVersion": "1.0.6",
  "description": "스텔라이브 멤버의 치지직 방송 상태를 확인하고 데스크톱 알림을 보내주는 Linux용 비공식 포크",
  "author": {
    "name": "StellaStatus",
    "email": "tabi.luv@icloud.com"
  },
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "gen-icon": "node scripts/gen-icon.mjs",
    "gen-logos": "node scripts/normalize-logos.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --linux AppImage",
    "release": "electron-builder --linux AppImage --publish never"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "stellastatus": "^0.1.0"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maroshall/stellastatus_app.git"
  }
}
